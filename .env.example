# CyberRecon-Pro environment configuration
# Copy this file to .env and fill in your own values. Never commit .env.

# ── Gemini AI analysis (optional) ─────────────────────────────────────────
# Free key: https://ai.google.dev/  - when enabled, finding summaries are sent to Google.
GEMINI_API_KEY=your_api_key_here
# Set to true to switch AI analysis off entirely
DISABLE_GEMINI=false

# ── NVD CVE lookup (optional key = higher rate limit) ─────────────────────
# Only the product identifier (vendor:product:version) is sent to NVD, never the target.
# Request a key: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Set to true to keep the scanner fully offline
DISABLE_NVD=false

# ── OpenVAS / Greenbone (optional) ────────────────────────────────────────
GVM_USER=admin
GVM_PASSWORD=change_me

# ── Login alert via Twilio WhatsApp (optional) ────────────────────────────
DANISHRECON_TWILIO_ENABLED=0
DANISHRECON_TWILIO_ACCOUNT_SID=
DANISHRECON_TWILIO_AUTH_TOKEN=
DANISHRECON_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
DANISHRECON_TWILIO_WHATSAPP_TO=
